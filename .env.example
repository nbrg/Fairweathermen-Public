# Copy this file to .env and fill in your own values.
# .env is gitignored — never commit real secrets.

# --- Required ---

# Postgres connection string.
# Local dev / tests: a plain postgres:// URL (local, Docker, Supabase, RDS, …).
# Production on Neon: a Neon URL — the server auto-detects it and uses the
# serverless (WebSocket) driver. Force the driver with DATABASE_DRIVER if needed.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/fairweathermen

# Optional: force the DB driver. "pg" = plain node-postgres, "neon" = Neon
# serverless. Leave unset to auto-detect from DATABASE_URL.
# DATABASE_DRIVER=pg

# Secret that guards the admin pages (/admin/*, /activity, /audit). Any string.
ADMIN_API_KEY=change-me

# HMAC secret for the signed group/login cookie. Use a long random string.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GROUP_COOKIE_SECRET=change-me-to-a-long-random-string

# --- Optional ---

# football-data.org v4 API key. Without it, live scores and fixture imports are
# skipped and the app runs on whatever is in your database.
# FOOTBALL_DATA_API_KEY=

# Web-push (VAPID) key pair for kickoff reminders. Generate with:
#   npx tsx scripts/generateVapidKeys.ts
# Push is disabled (and the reminder job is a no-op) if these are unset.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# Server port (default 5000).
# PORT=5000
